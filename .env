# =========================
# Koha Instance Settings
# =========================
KOHA_INSTANCE=kohadev
KOHA_DOMAIN=.myDNSname.org

KOHA_INTRANET_PORT=8081
KOHA_INTRANET_PREFIX=
KOHA_INTRANET_SUFFIX=-intra

KOHA_OPAC_PORT=8080
KOHA_OPAC_PREFIX=
KOHA_OPAC_SUFFIX=

KOHA_MARC_FLAVOUR=marc21
ZEBRA_MARC_FORMAT=marc21
KOHA_LANGS=es-ES

# Koha admin login
KOHA_USER=koha
KOHA_PASS=koha

# =========================
# Database Settings
# =========================
MYSQL_SERVER=db
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=password

MYSQL_DATABASE=koha_kohadev
MYSQL_USER=koha_kohadev
MYSQL_PASSWORD=password

# =========================
# Volumes
# =========================
DB_VOLUME=db-data
INSTANCE_VOLUME=/tmp/koha/instance
ETC_VOLUME=/tmp/koha/etc

# =========================
# Optional Koha Features
# =========================
USE_SIP=
USE_NCIP=
OVERRIDE_SYSPREF_SearchEngine=Elasticsearch

# =========================
# Mana Knowledge Base
# =========================
MANA_URL=https://mana-test.koha-community.org