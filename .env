# Koha version
KOHA_VERSION=26.05

# Koha instance
KOHA_INSTANCE=risinglibrary

# DB settings
MYSQL_ROOT_PASSWORD=Rising0605
MYSQL_USER=koha_rising
MYSQL_PASSWORD=Rising0605
MYSQL_SERVER=db

# Koha domain + prefixes
KOHA_DOMAIN=.localhost
KOHA_INTRANET_PREFIX=staff-
KOHA_INTRANET_SUFFIX=
KOHA_OPAC_PREFIX=opac-
KOHA_OPAC_SUFFIX=

# Nginx / TLS
NGINX_SERVER_NAME=risinglibrary.local
NGINX_SSL_CERT=/etc/nginx/certs/fullchain.pem
NGINX_SSL_KEY=/etc/nginx/certs/privkey.pem
